<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>name</key><string>Captain</string>
  <key>settings</key>
  <array>
    <dict>
      <key>settings</key>
      <dict>
        <key>background</key><string>#050506</string>
        <key>foreground</key><string>#F4F4F5</string>
        <key>caret</key><string>#F4F4F5</string>
        <key>selection</key><string>#222226</string>
        <key>lineHighlight</key><string>#151518</string>
      </dict>
    </dict>
    <dict>
      <key>name</key><string>Comment</string>
      <key>scope</key><string>comment, punctuation.definition.comment</string>
      <key>settings</key><dict><key>foreground</key><string>#A1A1AA</string></dict>
    </dict>
    <dict>
      <key>name</key><string>String</string>
      <key>scope</key><string>string, string.quoted</string>
      <key>settings</key><dict><key>foreground</key><string>#8BA888</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Number</string>
      <key>scope</key><string>constant.numeric, constant.language, constant.character</string>
      <key>settings</key><dict><key>foreground</key><string>#F59E0B</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Keyword</string>
      <key>scope</key><string>keyword, keyword.control, storage, storage.type</string>
      <key>settings</key><dict><key>foreground</key><string>#8D7FC0</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Function</string>
      <key>scope</key><string>entity.name.function, support.function</string>
      <key>settings</key><dict><key>foreground</key><string>#38BDF8</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Type</string>
      <key>scope</key><string>entity.name.type, entity.name.class, support.type, support.class</string>
      <key>settings</key><dict><key>foreground</key><string>#F59E0B</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Variable</string>
      <key>scope</key><string>variable, variable.parameter</string>
      <key>settings</key><dict><key>foreground</key><string>#D4D4D8</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Operator / punctuation</string>
      <key>scope</key><string>keyword.operator, punctuation</string>
      <key>settings</key><dict><key>foreground</key><string>#D4D4D8</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Markup heading</string>
      <key>scope</key><string>markup.heading, entity.name.section</string>
      <key>settings</key><dict><key>foreground</key><string>#8D7FC0</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Markup link</string>
      <key>scope</key><string>markup.underline.link, string.other.link</string>
      <key>settings</key><dict><key>foreground</key><string>#38BDF8</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Markup inline code</string>
      <key>scope</key><string>markup.raw.inline, markup.raw.block</string>
      <key>settings</key><dict><key>foreground</key><string>#8BA888</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Diff inserted</string>
      <key>scope</key><string>markup.inserted</string>
      <key>settings</key><dict><key>foreground</key><string>#7DA876</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Diff deleted</string>
      <key>scope</key><string>markup.deleted</string>
      <key>settings</key><dict><key>foreground</key><string>#D06F82</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Invalid</string>
      <key>scope</key><string>invalid, invalid.illegal</string>
      <key>settings</key><dict><key>foreground</key><string>#D06F82</string></dict>
    </dict>
  </array>
</dict>
</plist>
