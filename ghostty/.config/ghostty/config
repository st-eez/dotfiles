# Use zsh regardless of system default shell
command = zsh

# Theme colors - managed by theme-set (symlink)
config-file = ?"~/.config/ghostty/theme.conf"

background-opacity = 0.85
font-family = JetBrainsMono Nerd Font
font-size = 13
keybind = shift+enter=text:\n
keybind = super+k=text:\x0c
keybind = super+left=text:\x1bOH

# Split appearance
unfocused-split-opacity = 0.5

macos-titlebar-style = transparent

# Disable paste protection warning
clipboard-paste-protection = false

# Enable copy on highlight
copy-on-select = clipboard
mouse-hide-while-typing = true
right-click-action = ignore

# Enable desktop notifs
desktop-notifications = true
