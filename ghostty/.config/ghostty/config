# The session is the surface. Anything that ends the surface ends the session;
# detach is internal to the surface — window and session both stay.
#
# Each Ghostty surface launches its own tmux session named by sh PID. A trap
# in the launcher kills the session whenever the launcher itself exits (clean
# end, SIGHUP from window-close, SIGTERM). After tmux exits, `has-session`
# decides: alive (= user did prefix+d) → fall to interactive zsh in this
# surface; dead (= last pane killed) → launcher exits → Ghostty closes the
# window. The launcher must NOT exec zsh — exec drops the trap.
command = "zsh -lc 'sess=ghostty-$$; trap \"tmux kill-session -t $sess 2>/dev/null; exit\" EXIT HUP TERM; tmux new-session -A -s $sess; tmux has-session -t $sess 2>/dev/null && zsh -i'"

# Theme colors - managed by theme-set (symlink)
config-file = ?"~/.config/ghostty/theme.conf"

background-opacity = 0.85
font-family = JetBrainsMono Nerd Font
font-size = 13
keybind = shift+enter=text:\n
keybind = super+k=text:\x0c
keybind = super+left=text:\x1bOH

# ── Route Cmd-shortcuts into tmux by emitting its prefix sequence ───────────
# Ghostty emits `<C-b><key>`; tmux's existing root bindings handle it. `\x02`
# is Ctrl-B (tmux's prefix2; safer than NUL=C-Space for byte encoding).
# tmux is guaranteed to be the foreground program (see `command =` above), so
# there is no "outside tmux" case to handle.
keybind = super+t=text:\x02c
keybind = super+w=text:\x02x
keybind = super+d=text:\x02|
keybind = super+shift+d=text:\x02-
keybind = super+1=text:\x021
keybind = super+digit_1=text:\x021
keybind = super+2=text:\x022
keybind = super+digit_2=text:\x022
keybind = super+3=text:\x023
keybind = super+digit_3=text:\x023
keybind = super+4=text:\x024
keybind = super+digit_4=text:\x024
keybind = super+5=text:\x025
keybind = super+digit_5=text:\x025
keybind = super+6=text:\x026
keybind = super+digit_6=text:\x026
keybind = super+7=text:\x027
keybind = super+digit_7=text:\x027
keybind = super+8=text:\x028
keybind = super+digit_8=text:\x028
keybind = super+9=text:\x02l
keybind = super+digit_9=text:\x02l

# Split appearance
unfocused-split-opacity = 0.5

# Hide macOS title bar (tmux status bar makes it redundant)
macos-titlebar-style = hidden
window-padding-x = 4
window-padding-y = 4

# Disable paste protection warning
clipboard-paste-protection = false

# Enable copy on highlight
copy-on-select = clipboard
mouse-hide-while-typing = true

# Enable desktop notifs
desktop-notifications = true

