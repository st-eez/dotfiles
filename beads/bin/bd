#!/usr/bin/env bash
# bd shim — shell-agnostic wrapper around the real bd binary.
#
# Replaces the prior $ZSH_CUSTOM/bd-wrapper.zsh function so the dotfiles
# integration fires regardless of shell or invocation context (interactive
# zsh, bash, agent Bash tools, scripts, cron, etc).
#
# Subcommands:
#   bd init                  # upstream init, then post-init integration
#   bd reapply-integration   # apply integration to an existing bd repo
#   bd <anything else>       # passes through to the real bd
#
# After init / reapply, this shim:
#   1. Links .beads/PRIME.md to the dotfiles template.
#   2. Replaces the <!-- BEGIN BEADS INTEGRATION --> block in CLAUDE.md.
#   3. Replaces the same block in AGENTS.md (skipped when AGENTS.md is a
#      symlink to CLAUDE.md — shared-constitution repos).
#   4. Merges bd prime hooks into .claude/settings.json.
#   5. Merges a bd prime SessionStart hook (startup|resume|compact) into
#      .codex/hooks.json, preserving repo-specific hooks.
#
# Templates live at $HOME/.dotfiles/beads/templates (overridable via
# BD_DOTFILES_TEMPLATES). This shim is meant to be symlinked into a PATH
# directory that precedes the real bd's location (e.g., ~/.local/bin/bd).
# The shim also handles `bd prime` directly so Claude Code hooks and manual
# prime refreshes read the canonical dotfiles template even in repos that have
# not yet had their .beads/PRIME.md copy converted to a symlink.

set -uo pipefail

TEMPLATES_DIR="${BD_DOTFILES_TEMPLATES:-$HOME/.dotfiles/beads/templates}"

# Resolve this shim's real path so we can skip its directory when locating
# the upstream bd binary (avoids self-recursion if PATH has duplicate dirs).
self_resolve() {
  local target=$1 link
  while link=$(readlink "$target" 2>/dev/null); do
    case $link in
      /*) target=$link ;;
      *)  target="$(cd "$(dirname "$target")" && pwd -P)/$link" ;;
    esac
  done
  printf '%s\n' "$(cd "$(dirname "$target")" && pwd -P)/$(basename "$target")"
}

SELF_PATH=$(self_resolve "$0")
SELF_DIR=$(dirname "$SELF_PATH")

find_real_bd() {
  local IFS=:
  local d candidate resolved
  for d in $PATH; do
    [[ -z "$d" ]] && continue
    candidate="$d/bd"
    [[ -x "$candidate" ]] || continue
    resolved=$(self_resolve "$candidate") || continue
    [[ "$resolved" == "$SELF_PATH" ]] && continue
    printf '%s\n' "$candidate"
    return 0
  done
  return 1
}

canonical_template_path() {
  local template=$1 dir base
  case "$template" in
    /*) ;;
    *) template="$PWD/$template" ;;
  esac

  dir=$(dirname "$template")
  base=$(basename "$template")
  [[ -d "$dir" ]] || return 1
  printf '%s/%s\n' "$(cd "$dir" && pwd -P)" "$base"
}

print_prime() {
  local template
  template=$(canonical_template_path "$TEMPLATES_DIR/prime.md") || return 1
  [[ -f "$template" ]] || return 1
  cat "$template"
}

link_prime_template() {
  local template link_target
  template=$(canonical_template_path "$TEMPLATES_DIR/prime.md") || return 1
  [[ -f "$template" ]] || return 1

  case "$template" in
    "$PWD"/*) link_target="../${template#"$PWD"/}" ;;
    *) link_target="$template" ;;
  esac

  ln -sfn "$link_target" .beads/PRIME.md || return 1
  echo "bd-shim: linked .beads/PRIME.md -> $link_target"
}

# Ensure $1 contains a managed Beads integration block sourced from $2.
# If markers already exist, replace the content between them. If markers are
# absent, insert a new block after the top-level heading, or append if there is
# no heading. A partial marker pair is treated as an error to avoid corruption.
replace_block() {
  local file=$1 template=$2
  [[ -f "$file" && -f "$template" ]] || return 0

  local has_begin=0 has_end=0
  grep -q '^<!-- BEGIN BEADS INTEGRATION' "$file" && has_begin=1
  grep -q '^<!-- END BEADS INTEGRATION' "$file" && has_end=1
  if [[ "$has_begin" != "$has_end" ]]; then
    echo "bd-shim: partial BEADS block markers in $file; leaving unchanged" >&2
    return 1
  fi

  local tmp hash begin_marker end_marker
  tmp=$(mktemp) || return 1
  hash=$(shasum -a 256 "$template" 2>/dev/null | awk '{print substr($1,1,8)}') || hash=""
  [[ -n "$hash" ]] || hash="unknown"
  begin_marker="<!-- BEGIN BEADS INTEGRATION v:1 hash:$hash -->"
  end_marker="<!-- END BEADS INTEGRATION -->"

  if [[ "$has_begin" -eq 1 ]]; then
    awk -v tf="$template" -v begin_marker="$begin_marker" '
      BEGIN {
        while ((getline line < tf) > 0) content = content line "\n"
        close(tf)
        sub(/\n$/, "", content)
      }
      /^<!-- BEGIN BEADS INTEGRATION/ { print begin_marker; print content; in_block=1; next }
      /^<!-- END BEADS INTEGRATION/   { print; in_block=0; next }
      in_block                         { next }
      { print }
    ' "$file" > "$tmp" && mv "$tmp" "$file"
    echo "bd-shim: replaced BEADS block in $file"
  else
    awk -v tf="$template" -v begin_marker="$begin_marker" -v end_marker="$end_marker" '
      BEGIN {
        while ((getline line < tf) > 0) content = content line "\n"
        close(tf)
        sub(/\n$/, "", content)
      }
      NR == 1 && /^# / {
        print
        print ""
        print begin_marker
        print content
        print end_marker
        inserted=1
        next
      }
      { print }
      END {
        if (!inserted) {
          if (NR > 0) print ""
          print begin_marker
          print content
          print end_marker
        }
      }
    ' "$file" > "$tmp" && mv "$tmp" "$file"
    echo "bd-shim: inserted BEADS block in $file"
  fi
}

# Project-scoped Claude Code hooks: SessionStart + PreCompact run `bd prime`.
# Idempotent: existing hooks are merged, not replaced.
write_claude_hooks() {
  mkdir -p .claude || return 1
  local settings=.claude/settings.json

  if ! command -v python3 >/dev/null 2>&1; then
    if [[ -f "$settings" ]]; then
      echo "bd-shim: python3 missing; leaving existing $settings unchanged" >&2
      return 0
    fi
    cat > "$settings" <<'JSON'
{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime"
          }
        ]
      }
    ]
  }
}
JSON
    echo "bd-shim: wrote $settings"
    return 0
  fi

  python3 - "$settings" <<'PY'
import json
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
try:
    data = json.loads(path.read_text())
except FileNotFoundError:
    data = {}
except json.JSONDecodeError as exc:
    print(f"bd-shim: invalid {path}: {exc}", file=sys.stderr)
    sys.exit(1)

hooks = data.setdefault("hooks", {})

def ensure_bd_prime(event):
    groups = hooks.setdefault(event, [])
    for group in groups:
        if group.get("matcher", "") != "":
            continue
        commands = group.setdefault("hooks", [])
        for hook in commands:
            if hook.get("type") == "command" and hook.get("command") == "bd prime":
                return False
        commands.append({"type": "command", "command": "bd prime"})
        return True

    groups.append({
        "matcher": "",
        "hooks": [
            {"type": "command", "command": "bd prime"},
        ],
    })
    return True

changed = ensure_bd_prime("SessionStart")
changed = ensure_bd_prime("PreCompact") or changed

if changed:
    path.write_text(json.dumps(data, indent=2) + "\n")
    print(f"bd-shim: updated {path}")
else:
    print(f"bd-shim: {path} already wired")
PY
}

# Project-scoped Codex hook: SessionStart injects bd prime on startup, resume,
# and post-compaction (so long sessions re-load the rules). Merge-based like
# the Claude hooks: existing repo-specific hooks (e.g. knowledge-prime
# commands) are preserved; legacy `bd prime-codex` commands are migrated to
# `bd prime`; the matcher is upgraded to include `compact`.
# Codex treats project-local hooks as trust-gated — you'll be prompted once
# per new repo to mark it trusted before the hook fires.
write_codex_hooks() {
  mkdir -p .codex || return 1
  local hooks=.codex/hooks.json

  if ! command -v python3 >/dev/null 2>&1; then
    if [[ -f "$hooks" ]]; then
      echo "bd-shim: python3 missing; leaving existing $hooks unchanged" >&2
      return 0
    fi
    cat > "$hooks" <<'JSON'
{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
JSON
    echo "bd-shim: wrote $hooks"
    return 0
  fi

  python3 - "$hooks" <<'PY'
import json
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
try:
    data = json.loads(path.read_text())
except FileNotFoundError:
    data = {}
except json.JSONDecodeError as exc:
    print(f"bd-shim: invalid {path}: {exc}", file=sys.stderr)
    sys.exit(1)

MATCHER = "startup|resume|compact"
hooks = data.setdefault("hooks", {})
groups = hooks.setdefault("SessionStart", [])
changed = False
found = False

for group in groups:
    if "startup" not in group.get("matcher", ""):
        continue
    if group.get("matcher") != MATCHER:
        group["matcher"] = MATCHER
        changed = True
    for hook in group.setdefault("hooks", []):
        if hook.get("type") != "command":
            continue
        if hook.get("command") == "bd prime-codex":
            hook["command"] = "bd prime"
            changed = True
        if hook.get("command") == "bd prime":
            found = True
    if not found:
        group["hooks"].insert(0, {"type": "command", "command": "bd prime", "timeout": 5})
        changed = True
        found = True
    break

if not found:
    groups.append({
        "matcher": MATCHER,
        "hooks": [{"type": "command", "command": "bd prime", "timeout": 5}],
    })
    changed = True

if changed:
    path.write_text(json.dumps(data, indent=2) + "\n")
    print(f"bd-shim: updated {path}")
else:
    print(f"bd-shim: {path} already wired")
PY
}

post_init() {
  [[ -d .beads ]] || return 0
  if [[ ! -d "$TEMPLATES_DIR" ]]; then
    echo "bd-shim: templates dir missing: $TEMPLATES_DIR" >&2
    return 0
  fi

  if [[ -f "$TEMPLATES_DIR/prime.md" ]]; then
    link_prime_template
  fi

  replace_block CLAUDE.md "$TEMPLATES_DIR/claude.md"
  if [[ -L AGENTS.md ]]; then
    echo "bd-shim: AGENTS.md is a symlink to a shared constitution — skipping separate block (CLAUDE.md block covers it)"
  else
    replace_block AGENTS.md "$TEMPLATES_DIR/agents.md"
  fi
  write_claude_hooks
  write_codex_hooks
}

case "${1:-}" in
  prime)
    shift
    if [[ $# -eq 0 ]] && print_prime; then
      exit 0
    fi
    REAL_BD=$(find_real_bd) || {
      echo "bd-shim: real bd binary not found in PATH (skipped self at $SELF_DIR)" >&2
      exit 127
    }
    exec "$REAL_BD" prime "$@"
    ;;
  prime-codex)
    # Deprecated alias (2026-07-10): engines share one prime now. Kept so
    # repos whose .codex/hooks.json still calls prime-codex keep working.
    shift
    if [[ $# -ne 0 ]]; then
      echo "Usage: bd prime-codex" >&2
      exit 2
    fi
    print_prime
    ;;
  reapply-integration)
    shift
    REAL_BD=$(find_real_bd) || {
      echo "bd-shim: real bd binary not found in PATH (skipped self at $SELF_DIR)" >&2
      exit 127
    }
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
      cat <<USAGE
Usage: bd reapply-integration

Reapply the dotfiles-managed Beads integration to an existing bd repo:
  - .beads/PRIME.md symlink to the canonical dotfiles template
  - CLAUDE.md Beads block, inserted or replaced
  - AGENTS.md Beads block, inserted or replaced
  - .claude/settings.json bd prime hooks
  - .codex/hooks.json conditional Beads hook

This does not run bd init or modify the Beads database.
USAGE
      exit 0
    fi
    if [[ $# -ne 0 ]]; then
      echo "Usage: bd reapply-integration" >&2
      exit 2
    fi
    if [[ ! -d .beads ]]; then
      echo "bd reapply-integration: no .beads directory in current repo" >&2
      exit 1
    fi
    post_init
    ;;
  init)
    REAL_BD=$(find_real_bd) || {
      echo "bd-shim: real bd binary not found in PATH (skipped self at $SELF_DIR)" >&2
      exit 127
    }
    for arg in "$@"; do
      case "$arg" in
        -h|--help)
          exec "$REAL_BD" "$@"
          ;;
      esac
    done
    "$REAL_BD" "$@" || exit $?
    post_init
    ;;
  *)
    REAL_BD=$(find_real_bd) || {
      echo "bd-shim: real bd binary not found in PATH (skipped self at $SELF_DIR)" >&2
      exit 127
    }
    exec "$REAL_BD" "$@"
    ;;
esac
