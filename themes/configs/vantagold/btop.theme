# Vantagold theme for btop
# Managed by theme-set - do not edit manually

# Main
theme[main_bg]=""
theme[main_fg]="#eadfca"
theme[title]="#eadfca"
theme[hi_fg]="#8f9ebc"
theme[selected_bg]="#201b12"
theme[selected_fg]="#eadfca"
theme[inactive_fg]="#8f8778"
theme[graph_text]="#8f8778"
theme[proc_misc]="#8fa477"

# Box outlines
theme[cpu_box]="#8fa477"
theme[mem_box]="#ad8fa8"
theme[net_box]="#7f9f9a"
theme[proc_box]="#8f9ebc"
theme[div_line]="#8f8778"

# Temperature: green -> yellow -> red
theme[temp_start]="#8fa477"
theme[temp_mid]="#d6b85c"
theme[temp_end]="#c8a24a"

# CPU: green -> yellow -> red
theme[cpu_start]="#8fa477"
theme[cpu_mid]="#d6b85c"
theme[cpu_end]="#c8a24a"

# Mem/Disk used: red -> orange (warm = consumption)
theme[used_start]="#b9853d"
theme[used_mid]=""
theme[used_end]="#c8a24a"

# Mem/Disk available: green -> cyan (cool = headroom)
theme[available_start]="#8fa477"
theme[available_mid]=""
theme[available_end]="#7f9f9a"

# Mem/Disk free: blue -> cyan
theme[free_start]="#8f9ebc"
theme[free_mid]=""
theme[free_end]="#7f9f9a"

# Mem/Disk cached: magenta -> blue
theme[cached_start]="#ad8fa8"
theme[cached_mid]=""
theme[cached_end]="#8f9ebc"

# Download: cyan -> blue
theme[download_start]="#7f9f9a"
theme[download_mid]=""
theme[download_end]="#8f9ebc"

# Upload: orange -> red
theme[upload_start]="#b9853d"
theme[upload_mid]=""
theme[upload_end]="#c8a24a"

# Process: green -> orange -> red
theme[process_start]="#8fa477"
theme[process_mid]="#b9853d"
theme[process_end]="#c8a24a"
