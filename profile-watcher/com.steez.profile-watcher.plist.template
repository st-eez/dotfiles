<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.steez.profile-watcher</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.local/bin/profile-watcher</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/AeroSpace/profile-watcher.agent.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/AeroSpace/profile-watcher.agent.log</string>
</dict>
</plist>
